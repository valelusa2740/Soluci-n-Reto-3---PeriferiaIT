# Copia a .env en local o configura estas variables en Render. NUNCA subas .env al repositorio.
# Proveedor del modelo: gemini (requiere clave de Google AI Studio) o local (sin modelo, determinista).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Respaldo automático si el principal está saturado (503/500/429/timeout tras reintentos). "ninguno" lo desactiva.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Acceso al chat (HTTP Basic). Obligatorio en producción; ACCESS_PASS de al menos 10 caracteres.
ACCESS_USER=
ACCESS_PASS=
# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
MAX_TOKENS_DIA=2000000
MAX_TOKENS_RESPUESTA=2000
LLM_TIMEOUT_MS=60000
MAX_PETICIONES_MINUTO=10
PORT=3000
