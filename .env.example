# Copia a .env en local o configura estas variables en Render. NUNCA subas .env al repositorio.
# Proveedor del modelo: anthropic (requiere clave) o local (sin modelo, determinista).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Acceso al chat (HTTP Basic). Obligatorio en producción.
ACCESS_USER=
ACCESS_PASS=
# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
MAX_TOKENS_DIA=2000000
MAX_TOKENS_RESPUESTA=2000
LLM_TIMEOUT_MS=60000
MAX_PETICIONES_MINUTO=20
PORT=3000
